VOYAGE_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
DATABASE_URL=postgresql://postgres:***@localhost:5433/sleuth
GENERATION_PROVIDER=groq
NIM_API_KEY=
# CORS allow_origins for the FastAPI backend — must match wherever the React
# frontend is actually served from, or the browser silently blocks every
# request (visible as a cryptic CORS network error, not from the backend).
# Defaults to the local Vite dev server if unset.
FRONTEND_ORIGIN=http://localhost:5717
# Signs the session cookie (see sleuth/api/auth/session.py) — the cookie
# embeds a user's email/name/theme_preference as claims verified purely by
# this signature, so anyone who knows it can forge a valid session for any
# user_id with zero DB check. Generate a real one, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Leaving this unset falls back to a well-known, publicly-visible-in-source
# placeholder — fine for a throwaway local dev DB, never for anything real.
SESSION_SECRET=
